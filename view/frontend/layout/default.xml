<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="after.body.start">
            <block class="KingfisherDirect\Posthog\Block\Script"
                   name="posthog.script"
                   template="KingfisherDirect_Posthog::script.phtml"
                   after="-"/>
            <block class="KingfisherDirect\Posthog\Block\ProductProperties"
                   name="posthog.product.properties"
                   template="KingfisherDirect_Posthog::product_properties.phtml"
                   after="posthog.script"/>
        </referenceContainer>
    </body>
</page>
