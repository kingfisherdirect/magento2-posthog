<?php
/**
 * PostHog product attribute registration.
 *
 * Renders on every page. Always unregisters the configured product
 * attribute keys first, then re-registers them for the current product
 * (via register_for_session, so they don't persist beyond the session).
 * Unregistering unconditionally, even on product pages, prevents stale
 * values from a previously viewed product leaking into a differently
 * attributed product when navigating directly between product pages.
 *
 * @var \KingfisherDirect\Posthog\Block\ProductProperties $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

$keys = $block->getPropertyKeys();
$properties = $block->getPropertiesToRegister();
?>
<?php if (!empty($keys)): ?>
<?php
$keysJson = json_encode($keys, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
$propertiesJson = json_encode($properties, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
$scriptString = <<<SCRIPT
    if (typeof posthog !== "undefined") {
        {$keysJson}.forEach(function (key) {
            posthog.unregister_for_session(key);
        });
        posthog.register_for_session({$propertiesJson});
    }
    SCRIPT;
?>
<?= $secureRenderer->renderTag('script', [], $scriptString, false) ?>
<?php endif ?>
